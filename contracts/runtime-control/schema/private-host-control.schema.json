{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://respire.rs/contracts/runtime-control/private-host-control.schema.json",
  "title": "Inherited auth continuation, model preparation, snapshot maintenance and private secret fixtures",
  "description": "Frozen model_control.rs DTOs use HostModelParams and ModelPreparation. x-methods selects decoded args/result validation. Selection SHA-256 is opaque: fixtures bind request to response, never claim authoritative recomputation or native execution.",
  "type": "object",
  "required": [
    "fixture_type",
    "expected",
    "payload"
  ],
  "properties": {
    "fixture_type": {
      "const": "private_host_control"
    },
    "expected": {
      "enum": [
        "accept",
        "reject"
      ]
    },
    "error_code": {
      "type": "string"
    },
    "payload": {
      "$ref": "#/$defs/case"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "binding": {
      "type": "object",
      "required": [
        "installation_root",
        "profile",
        "launch_id"
      ],
      "properties": {
        "installation_root": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "launch_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "expected_account_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "identity": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "absent"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "operation_id",
            "session_sha256"
          ],
          "properties": {
            "kind": {
              "const": "unbound"
            },
            "operation_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "session_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "account_id",
            "session_sha256"
          ],
          "properties": {
            "kind": {
              "const": "bound"
            },
            "account_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "session_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "controlParams": {
      "type": "object",
      "required": [
        "schema_version",
        "binding"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "binding": {
          "$ref": "#/$defs/binding"
        }
      },
      "additionalProperties": false
    },
    "keygenParams": {
      "type": "object",
      "required": [
        "schema_version",
        "binding",
        "identity",
        "force"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "binding": {
          "$ref": "#/$defs/binding"
        },
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "force": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "registerParams": {
      "type": "object",
      "required": [
        "schema_version",
        "binding",
        "identity",
        "addr",
        "user",
        "password"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "binding": {
          "$ref": "#/$defs/binding"
        },
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "addr": {
          "type": "string",
          "minLength": 1
        },
        "user": {
          "type": "string",
          "minLength": 1
        },
        "password": {
          "type": "string"
        },
        "super_password": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "authorization": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "password"
          ],
          "properties": {
            "kind": {
              "const": "password"
            },
            "password": {
              "type": "string"
            },
            "totp": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "token"
          ],
          "properties": {
            "kind": {
              "const": "browser"
            },
            "token": {
              "type": "string",
              "minLength": 1
            },
            "session_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "loginParams": {
      "type": "object",
      "required": [
        "schema_version",
        "binding",
        "identity",
        "addr",
        "user",
        "authorization"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "binding": {
          "$ref": "#/$defs/binding"
        },
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "addr": {
          "type": "string",
          "minLength": 1
        },
        "user": {
          "type": "string",
          "minLength": 1
        },
        "authorization": {
          "$ref": "#/$defs/authorization"
        },
        "super_password": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "continuation": {
          "anyOf": [
            {
              "$ref": "#/$defs/loginContinuation"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "accountParams": {
      "type": "object",
      "required": [
        "schema_version",
        "binding",
        "identity"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "binding": {
          "$ref": "#/$defs/binding"
        },
        "identity": {
          "$ref": "#/$defs/identity"
        }
      },
      "additionalProperties": false
    },
    "keygenResult": {
      "type": "object",
      "required": [
        "operation_id",
        "outcome",
        "path"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "outcome": {
          "enum": [
            "committed",
            "rolled_back",
            "unknown"
          ]
        },
        "session_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "super_password": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "accountResult": {
      "type": "object",
      "required": [
        "operation_id",
        "outcome",
        "source_profile"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "outcome": {
          "enum": [
            "awaiting_input",
            "awaiting_verification",
            "committed",
            "rolled_back",
            "unknown"
          ]
        },
        "source_profile": {
          "type": "string",
          "minLength": 1
        },
        "target_profile": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "account_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "session_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "super_password": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "login": {
          "anyOf": [
            {
              "$ref": "#/$defs/loginStatus"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "snapshotParams": {
      "type": "object",
      "required": [
        "schema_version",
        "binding",
        "operation_id",
        "request_fingerprint",
        "sync_generation",
        "snapshot_id",
        "action"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "binding": {
          "$ref": "#/$defs/binding"
        },
        "operation_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "request_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sync_generation": {
          "type": "integer",
          "minimum": 1
        },
        "snapshot_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "action": {
          "enum": [
            "restore",
            "rollback",
            "recover",
            "query",
            "commit",
            "release"
          ]
        }
      },
      "additionalProperties": false
    },
    "snapshotResult": {
      "type": "object",
      "required": [
        "operation_id",
        "request_fingerprint",
        "snapshot_id",
        "state",
        "cleanup_pending"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "request_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "snapshot_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "state": {
          "enum": [
            "unknown",
            "prepared",
            "installed",
            "verified",
            "released",
            "rolled_back"
          ]
        },
        "before_restore": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "sync_quarantined": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "cleanup_pending": {
          "type": "boolean"
        },
        "cleanup_warning": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "asset": {
      "type": "object",
      "required": [
        "name",
        "suggested_source"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "suggested_source": {
          "type": "string"
        },
        "state": {
          "enum": [
            "missing",
            "incomplete",
            "corrupt",
            "incompatible",
            "complete"
          ]
        },
        "sha256": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        },
        "actual_sha256": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        },
        "version": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "expected_size": {
          "type": "integer",
          "minimum": 0
        },
        "actual_size": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "modelPlan": {
      "type": "object",
      "required": [
        "selection_sha256",
        "assets"
      ],
      "properties": {
        "selection_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "assets": {
          "$ref": "#/$defs/modelPlanAssets"
        }
      },
      "additionalProperties": false
    },
    "request": {
      "type": "object",
      "required": [
        "v",
        "id",
        "method",
        "args"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "operation_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "idempotency_key": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "method": {
          "enum": [
            "control.auth.keygen",
            "control.auth.result",
            "control.auth.register",
            "control.auth.login",
            "control.auth.account_result",
            "control.auth.account_complete",
            "control.auth.account_rollback",
            "control.model_install_plan",
            "control.snapshot_maintenance",
            "control.model_install_verify",
            "control.secret.read",
            "control.keys_export.read",
            "control.identity.session_list",
            "control.config_validate"
          ]
        },
        "args": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "scope": {
          "type": "null"
        },
        "parent_operation_id": {
          "type": "null"
        },
        "queue_wait_ms": {
          "type": "null"
        },
        "lifecycle": {
          "type": "null"
        }
      },
      "additionalProperties": false
    },
    "history": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/snapshotResult"
      }
    },
    "case": {
      "type": "object",
      "required": [
        "channel",
        "maintenance_phase",
        "request",
        "finish_maintenance"
      ],
      "properties": {
        "channel": {
          "enum": [
            "inherited_pipe",
            "public_http"
          ]
        },
        "maintenance_phase": {
          "enum": [
            "Paused",
            "Verified",
            "Starting",
            "Idle"
          ]
        },
        "request": {
          "$ref": "#/$defs/request"
        },
        "result": {
          "type": "object"
        },
        "finish_maintenance": {
          "type": "boolean"
        },
        "original_operation_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "original_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "history": {
          "$ref": "#/$defs/history"
        },
        "public_response": {
          "type": "object"
        },
        "private_response": {
          "type": "object"
        },
        "config_context": {
          "$ref": "#/$defs/configContext"
        }
      },
      "additionalProperties": false
    },
    "backendLoadRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "api_version",
        "version",
        "build_info_sha256"
      ],
      "properties": {
        "kind": {
          "const": "onnxruntime"
        },
        "api_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "not": {
            "pattern": "^0[xX][0-9a-fA-F]+$"
          }
        },
        "build_info_sha256": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "backendLoadSdkPin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "sdk_version",
        "manifest_sha256"
      ],
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "not": {
            "pattern": "^0[xX][0-9a-fA-F]+$"
          }
        },
        "sdk_version": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "not": {
            "pattern": "^0[xX][0-9a-fA-F]+$"
          }
        },
        "manifest_sha256": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "backendLoadModule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "not": {
            "pattern": "^0[xX][0-9a-fA-F]+$"
          }
        },
        "sha256": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "backendLoadEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "status",
        "ready",
        "backend",
        "engine",
        "selected",
        "provider",
        "fresh_session",
        "inference_completed",
        "model",
        "index_identity",
        "dimensions",
        "node_assignment",
        "cpu_node_fallback",
        "runtime",
        "sdk_pin",
        "modules",
        "module_identity_source"
      ],
      "properties": {
        "contract": {
          "const": 1
        },
        "status": {
          "const": "loaded"
        },
        "ready": {
          "const": true
        },
        "backend": {
          "const": "onnx"
        },
        "engine": {
          "enum": [
            "cpu",
            "gpu",
            "npu"
          ]
        },
        "selected": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(CPU|Host|Gpu: DmlExecutionProvider|Npu: [A-Za-z][A-Za-z0-9_]*)$"
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "fresh_session": {
          "const": true
        },
        "inference_completed": {
          "const": true
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "not": {
            "pattern": "^0[xX][0-9a-fA-F]+$"
          }
        },
        "index_identity": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(m3|[a-f0-9]{64})$"
        },
        "dimensions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "node_assignment": {
          "const": "not_measured"
        },
        "cpu_node_fallback": {
          "enum": [
            "allowed",
            "disabled",
            "host_managed",
            "not_applicable"
          ]
        },
        "runtime": {
          "$ref": "#/$defs/backendLoadRuntime"
        },
        "sdk_pin": {
          "$ref": "#/$defs/backendLoadSdkPin"
        },
        "modules": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/backendLoadModule"
          }
        },
        "module_identity_source": {
          "const": "host_verified"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "selected": {
                "const": "CPU"
              }
            }
          },
          "then": {
            "properties": {
              "engine": {
                "const": "cpu"
              },
              "provider": {
                "const": "CPUExecutionProvider"
              },
              "cpu_node_fallback": {
                "const": "not_applicable"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "selected": {
                "const": "Gpu: DmlExecutionProvider"
              }
            }
          },
          "then": {
            "properties": {
              "engine": {
                "const": "gpu"
              },
              "provider": {
                "const": "DmlExecutionProvider"
              },
              "cpu_node_fallback": {
                "const": "allowed"
              }
            }
          }
        },
        {
          "if": {
